[Unit]
Description=NeroAI Celery Background Worker Service
After=network.target redis.service neroai-backend.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/var/www/codebot
EnvironmentFile=/var/www/codebot/.env

# Run Celery worker with concurrency=2 for 1 CPU
ExecStart=/var/www/codebot/.venv/bin/celery -A apps.backend.bot.application.core.celery:celery_app worker --loglevel=INFO --concurrency=2

Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
